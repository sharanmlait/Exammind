# ---------- LLM (chat, MCQs, grading, agent) ----------
# groq | gemini | ollama | mock   (mock = offline demo, no key needed)
LLM_PROVIDER=groq
GROQ_API_KEY=            # free: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=          # free: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# ---------- Exam-answer model (your fine-tuned model) ----------
# empty = same as LLM_PROVIDER. After fine-tuning: ANSWER_LLM_PROVIDER=ollama, OLLAMA_MODEL=exammind
ANSWER_LLM_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=exammind

# ---------- Embeddings ----------
# sentence-transformers (needs requirements-ml.txt) | hash (offline fallback)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------- Retrieval tuning ----------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5
HYBRID_ALPHA=0.6
MIN_RELEVANCE=0.15

CORS_ORIGINS=http://localhost:3000
